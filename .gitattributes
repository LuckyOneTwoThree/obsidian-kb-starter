# 文本统一 LF，避免 Obsidian 在 Windows 保存时引入 CRLF
* text=auto eol=lf

*.md       text eol=lf
*.markdown text eol=lf
*.txt      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.csv      text eol=lf
*.py       text eol=lf
*.sh       text eol=lf

# 二进制
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.svg  binary
*.pdf  binary
*.zip  binary
